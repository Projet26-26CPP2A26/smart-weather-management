               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <!-- RIGHT: TABLEAU, RECHERCHE & EXPORTS -->
           <item>
            <layout class="QVBoxLayout" name="rightVLayout">
             <property name="spacing"><number>10</number></property>
             <!-- TOOLBAR FILTRES -->
             <item>
              <widget class="QFrame" name="frameToolbar">
