                <item><property name="text"><string>ST-06_SIL (Siliana - Hautes Plaines)</string></property></item>
                <item><property name="text"><string>ST-09_KAS (Kasserine - Zone Montagneuse)</string></property></item>
                <item><property name="text"><string>ST-07_KAI (Kairouan - Oliveraies)</string></property></item>
                <item><property name="text"><string>ST-08_NAB (Nabeul - Agrumes Cap Bon)</string></property></item>
               </widget>
              </item>
              <!-- SLIDER & SPINBOX TEMPERATURE -->
              <item>
               <layout class="QHBoxLayout" name="layoutTempHeader">
                <item><widget class="QLabel" name="lblTemp"><property name="text"><string>T° au crépuscule (°C) :</string></property></widget></item>
                <item><widget class="QDoubleSpinBox" name="spnTemp"><property name="minimum"><double>-10.0</double></property><property name="maximum"><double>35.0</double></property><property name="value"><double>4.5</double></property><property name="singleStep"><double>0.5</double></property></widget></item>
               </layout>
              </item>
              <item>
               <widget class="QSlider" name="sliderTemp">
                <property name="orientation"><enum>Qt::Horizontal</enum></property>
                <property name="minimum"><number>-100</number></property>
                <property name="maximum"><number>350</number></property>
                <property name="value"><number>45</number></property>
               </widget>
              </item>
              <!-- SLIDER & SPINBOX HUMIDITE -->
              <item>
               <layout class="QHBoxLayout" name="layoutHumHeader">
                <item><widget class="QLabel" name="lblHum"><property name="text"><string>Humidité relative de l'air (%) :</string></property></widget></item>
                <item><widget class="QDoubleSpinBox" name="spnHum"><property name="minimum"><double>10.0</double></property><property name="maximum"><double>100.0</double></property><property name="value"><double>68.0</double></property><property name="singleStep"><double>1.0</double></property></widget></item>
               </layout>
              </item>
              <item>
               <widget class="QSlider" name="sliderHum">
                <property name="orientation"><enum>Qt::Horizontal</enum></property>
                <property name="minimum"><number>10</number></property>
                <property name="maximum"><number>100</number></property>
                <property name="value"><number>68</number></property>
               </widget>
              </item>
              <!-- SLIDER & SPINBOX VENT -->
              <item>
               <layout class="QHBoxLayout" name="layoutVentHeader">
                <item><widget class="QLabel" name="lblVent"><property name="text"><string>Vitesse moyenne du vent (km/h) :</string></property></widget></item>
                <item><widget class="QDoubleSpinBox" name="spnVent"><property name="minimum"><double>0.0</double></property><property name="maximum"><double>100.0</double></property><property name="value"><double>3.5</double></property><property name="singleStep"><double>0.5</double></property></widget></item>
               </layout>
              </item>
              <item>
               <widget class="QSlider" name="sliderVent">
