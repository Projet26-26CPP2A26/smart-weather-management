                  <item><property name="text"><string>Archivée</string></property></item>
                 </widget>
                </item>
               </layout>
              </widget>
             </item>
             <!-- TOOLBAR ACTIONS TRIS & EXPORT -->
             <item>
              <layout class="QHBoxLayout" name="layoutActionsTable">
               <item>
                <widget class="QPushButton" name="btnTriSeverite">
