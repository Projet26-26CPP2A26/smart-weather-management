                <property name="readOnly"><bool>true</bool></property>
                <property name="maximumSize"><size><width>16777215</width><height>85</height></size></property>
               </widget>
              </item>
              <!-- RECOMMANDATIONS -->
              <item><widget class="QLabel" name="lblTitreRecom"><property name="text"><string>Mesures Préventives &amp; Protection Agricole Immédiate :</string></property><property name="styleSheet"><string notr="true">font-weight: bold; color: #0f172a;</string></property></widget></item>
              <item>
