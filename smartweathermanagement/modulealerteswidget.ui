                   <item><widget class="QLabel" name="lblTMinValeur"><property name="text"><string>-1.2 °C</string></property><property name="styleSheet"><string notr="true">font-size: 22px; font-weight: bold; color: #0284c7;</string></property></widget></item>
                  </layout>
                 </widget>
                </item>
                <item>
                 <widget class="QFrame" name="boxDew">
                  <property name="styleSheet"><string notr="true">background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px;</string></property>
                  <layout class="QVBoxLayout" name="vboxDew">
                   <item><widget class="QLabel" name="lblDewTitre"><property name="text"><string>Point de Rosée Calculé</string></property><property name="styleSheet"><string notr="true">color: #0f172a; font-size: 13px; font-weight: bold;</string></property></widget></item>
                   <item><widget class="QLabel" name="lblDewValeur"><property name="text"><string>-0.8 °C</string></property><property name="styleSheet"><string notr="true">font-size: 22px; font-weight: bold; color: #0d9488;</string></property></widget></item>
                  </layout>
                 </widget>
                </item>
               </layout>
              </item>
              <!-- DIAGNOSTIC -->
              <item><widget class="QLabel" name="lblTitreDiag"><property name="text"><string>Analyse Physique &amp; Diagnostic :</string></property><property name="styleSheet"><string notr="true">font-weight: bold; color: #0f172a;</string></property></widget></item>
              <item>
