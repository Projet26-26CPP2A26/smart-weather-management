               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <!-- RIGHT: RESULTATS & DIAGNOSTIC INNOVANT -->
           <item>
            <widget class="QGroupBox" name="groupResultatsPred">
             <property name="title"><string>Diagnostic Agrométéorologique &amp; Décision Opérationnelle</string></property>
             <layout class="QVBoxLayout" name="predResLayout">
              <property name="spacing"><number>12</number></property>
